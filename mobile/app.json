{
  "expo": {
    "name": "LevelUp",
    "slug": "levelup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "levelup",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F0F14",
    "splash": {
      "backgroundColor": "#0F0F14",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.levelup.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F0F14",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.levelup.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
